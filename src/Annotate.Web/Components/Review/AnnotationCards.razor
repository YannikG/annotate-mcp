@if (Annotations.Count == 0)
{
    <EmptyState Title="No annotations yet." />
}
<ol class="stack" data-annotations>
    @foreach (Annotation annotation in Annotations)
    {
        <li data-kind="@annotation.Kind">
            <span class="kind">@annotation.Kind</span>
            <span data-text>@annotation.Text</span>
            @if (string.IsNullOrEmpty(annotation.Replacement))
            {
                <span data-replacement></span>
            }
            else
            {
                <span class="detail">
                    <span class="detail-label">Replacement</span>
                    <span data-replacement>@annotation.Replacement</span>
                </span>
            }
            @if (string.IsNullOrEmpty(annotation.Comment))
            {
                <span data-comment></span>
            }
            else
            {
                <span class="detail">
                    <span class="detail-label">Comment</span>
                    <span data-comment>@annotation.Comment</span>
                </span>
            }
            <span class="visually-hidden" data-block>@annotation.BlockOrdinal</span>
            <span class="visually-hidden" data-start>@annotation.StartOffset</span>
            <span class="visually-hidden" data-end>@annotation.EndOffset</span>
            <span class="visually-hidden" data-id>@annotation.Id</span>
            <span class="visually-hidden" data-created>@annotation.CreatedAt</span>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Annotation> Annotations { get; set; } = [];
}
