@if (Annotations.Count == 0)
{
    <EmptyState Title="No annotations yet." />
}
<ol class="stack" data-annotations>
    @foreach (Annotation annotation in Annotations)
    {
        <AnnotationThread Annotation="annotation" Pending="Pending" ReviewId="@ReviewId" BlockName="@Name(annotation.BlockKey)" Changed="Changed" Ask="Ask" />
    }
</ol>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Annotation> Annotations { get; set; } = [];

    [Parameter]
    public bool Pending { get; set; }

    [Parameter]
    public string? ReviewId { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public EventCallback<AnnotationConfirm> Ask { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, string>? BlockNames { get; set; }

    private string? Name(string? blockKey) =>
        blockKey is not null && BlockNames?.TryGetValue(blockKey, out string? name) == true ? name : blockKey;
}
