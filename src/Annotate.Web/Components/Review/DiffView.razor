@using System.Globalization
@using System.Numerics
@using System.Text.RegularExpressions

<div class="diff-block" data-diff>
    <div class="diff-title">Unified diff</div>
    <div class="diff-editor">
        @foreach (DiffLine line in Lines())
        {
            <div class="diff-line diff-@line.Kind">
                <span class="diff-number">@line.OldNumber</span>
                <span class="diff-number">@line.NewNumber</span>
                <span class="diff-marker">@line.Marker</span>
                <span class="diff-content" data-block-index="@Ordinal" data-seg-start="@line.Start" data-seg-end="@(line.Start + line.Text.Length)"><AnnotationText Source="@Source" Ordinal="Ordinal" Start="line.Start" End="@(line.Start + line.Text.Length)" /></span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Source { get; set; } = "";

    [Parameter, EditorRequired]
    public CodeBlock Fence { get; set; } = default!;

    [Parameter, EditorRequired]
    public int Ordinal { get; set; }

    private IEnumerable<DiffLine> Lines()
    {
        int bodyStart = Source.IndexOf('\n', Fence.Start) + 1;
        BigInteger oldLine = 1;
        BigInteger newLine = 1;
        int offset = 0;
        foreach (string raw in Fence.Body.Split('\n'))
        {
            if (offset >= Fence.Body.Length)
            {
                yield break;
            }

            string text = raw.TrimEnd('\r');
            int start = bodyStart + offset;
            offset += raw.Length + 1;
            Match hunk = Regex.Match(text, @"^@@ -([0-9]+)(?:,[0-9]+)? \+([0-9]+)(?:,[0-9]+)? @@", RegexOptions.CultureInvariant);
            if (hunk.Success)
            {
                oldLine = BigInteger.Parse(hunk.Groups[1].Value, CultureInfo.InvariantCulture);
                newLine = BigInteger.Parse(hunk.Groups[2].Value, CultureInfo.InvariantCulture);
                yield return new("hunk", null, null, "", text, start);
            }
            else if (text.StartsWith("+++", StringComparison.Ordinal)
                || text.StartsWith("---", StringComparison.Ordinal)
                || text.StartsWith("diff ", StringComparison.Ordinal)
                || text.StartsWith("index ", StringComparison.Ordinal))
            {
                yield return new("meta", null, null, "", text, start);
            }
            else if (text.StartsWith('+'))
            {
                yield return new("add", null, newLine++, "+", text[1..], start + 1);
            }
            else if (text.StartsWith('-'))
            {
                yield return new("del", oldLine++, null, "−", text[1..], start + 1);
            }
            else
            {
                bool marker = text.StartsWith(' ');
                yield return new("same", oldLine++, newLine++, " ", marker ? text[1..] : text, start + (marker ? 1 : 0));
            }
        }
    }

    private sealed record DiffLine(string Kind, BigInteger? OldNumber, BigInteger? NewNumber, string Marker, string Text, int Start);
}
