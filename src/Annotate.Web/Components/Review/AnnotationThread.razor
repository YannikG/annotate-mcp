@inject IServiceProvider Services

<li data-kind="@Annotation.Kind" data-author="@Annotation.Author">
    <div class="comment-head">
        <span class="comment-author">
            @if (Annotation.Author == AnnotationAuthor.Agent)
            {
                <span class="block-bot" data-bot aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="8" width="14" height="10" rx="2"></rect><path d="M12 8V4"></path><circle cx="9" cy="13" r="1"></circle><circle cx="15" cy="13" r="1"></circle></svg></span>
                <span>Agent</span>
            }
            else
            {
                <span class="kind">@Annotation.Kind</span>
            }
        </span>
        @if (Annotation.Author == AnnotationAuthor.Agent)
        {
            <Button Variant="ButtonVariant.Quiet" class="btn-sm comment-accept" data-accept data-accepted="@(Annotation.Accepted == true ? "true" : "false")" aria-pressed="@(Annotation.Accepted == true ? "true" : "false")" Disabled="@(!Pending)" OnClick="ToggleAccepted"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg>@(Annotation.Accepted == true ? "Accepted" : "Accept")</Button>
        }
        @if (Pending)
        {
            <Button Variant="ButtonVariant.Quiet" class="btn-sm icon-delete" data-delete-annotation aria-label="Delete annotation" title="Delete annotation" OnClick="AskAnnotation"><TrashIcon /></Button>
        }
    </div>
    @if (!string.IsNullOrEmpty(Annotation.Comment))
    {
        <p class="comment-body" data-comment>@Annotation.Comment</p>
    }
    else
    {
        <span data-comment></span>
    }
    @if (!string.IsNullOrEmpty(Annotation.BlockKey))
    {
        <span class="comment-key" data-block-key="@Annotation.BlockKey" title="@Annotation.BlockKey">@(BlockName ?? Annotation.BlockKey)</span>
    }
    <span data-text>@(Annotation.BlockKey is null ? Annotation.Text : null)</span>
    @if (string.IsNullOrEmpty(Annotation.Replacement))
    {
        <span data-replacement></span>
    }
    else
    {
        <span class="detail">
            <span class="detail-label">Replacement</span>
            <span data-replacement>@Annotation.Replacement</span>
        </span>
    }
    @if (Annotation.Replies is { Count: > 0 })
    {
        <ol data-replies>
            @foreach (AnnotationReply reply in Annotation.Replies)
            {
                <li data-reply>
                    <span data-reply-text>@reply.Text</span>
                    @if (Pending)
                    {
                        <Button Variant="ButtonVariant.Quiet" class="btn-sm icon-delete" data-delete-reply aria-label="Delete reply" title="Delete reply" OnClick="() => AskReply(reply.Id)"><TrashIcon /></Button>
                    }
                </li>
            }
        </ol>
    }
    @if (Pending)
    {
        <div class="reply-composer">
            <textarea @key="composer" class="reply-draft" rows="1" data-reply-draft aria-label="Reply" placeholder="Reply" @onfocus="OpenReply" @oninput="OnReply"></textarea>
            <div class="reply-actions" data-reply-actions hidden="@(!replyOpen)">
                <Button Variant="ButtonVariant.Quiet" class="btn-sm" OnClick="CancelReply">Cancel</Button>
                <Button Variant="ButtonVariant.Primary" class="btn-sm" data-add-reply Disabled="@(reply.Trim().Length == 0)" OnClick="SendReply">Reply</Button>
            </div>
        </div>
    }
    <span class="visually-hidden" data-block>@Annotation.BlockOrdinal</span>
    <span class="visually-hidden" data-start>@Annotation.StartOffset</span>
    <span class="visually-hidden" data-end>@Annotation.EndOffset</span>
    <span class="visually-hidden" data-id>@Annotation.Id</span>
    <span class="visually-hidden" data-created>@Annotation.CreatedAt</span>
</li>

@code {
    [Parameter, EditorRequired]
    public Annotation Annotation { get; set; } = default!;

    [Parameter]
    public bool Pending { get; set; }

    [Parameter]
    public string? ReviewId { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public EventCallback<AnnotationConfirm> Ask { get; set; }

    [Parameter]
    public EventCallback<string> RemovePhrase { get; set; }

    [Parameter]
    public string? BlockName { get; set; }

    private string reply = "";

    private bool replyOpen;

    private int composer;

    private void OnReply(ChangeEventArgs change)
    {
        reply = change.Value?.ToString() ?? "";
        replyOpen = true;
    }

    private void OpenReply() => replyOpen = true;

    private void CancelReply()
    {
        reply = "";
        replyOpen = false;
        composer++;
    }

    private Task AskAnnotation() =>
        Ask.InvokeAsync(new("Delete this annotation?", "This removes the annotation and its replies.", DeleteAnnotation));

    private Task AskReply(string replyId) =>
        Ask.InvokeAsync(new("Delete this reply?", "This removes the reply.", () => DeleteReply(replyId)));

    private Task ToggleAccepted() => SetAccepted(Annotation.Accepted != true);

    private async Task SetAccepted(bool accepted)
    {
        if (ReviewId is null || Reviews() is not IReviews reviews) return;
        SaveAnnotationsOutcome outcome = await reviews.SetAcceptedAsync(
            new ReviewId(ReviewId),
            Annotation.Id,
            accepted,
            CancellationToken.None);
        if (outcome is SaveAnnotationsOutcome.Done)
        {
            await Changed.InvokeAsync();
        }
    }

    private async Task SendReply()
    {
        if (ReviewId is null || reply.Trim().Length == 0 || Reviews() is not IReviews reviews) return;
        SaveAnnotationsOutcome outcome = await reviews.AddReplyAsync(new ReviewId(ReviewId), Annotation.Id, reply, CancellationToken.None);
        if (outcome is not SaveAnnotationsOutcome.Done) return;
        reply = "";
        replyOpen = false;
        composer++;
        await Changed.InvokeAsync();
    }

    private Task DeleteAnnotation() =>
        Annotation.BlockKey is null
            ? RemovePhrase.InvokeAsync(Annotation.Id)
            : Remove(reviews => reviews.DeleteAnnotationAsync(new ReviewId(ReviewId!), Annotation.Id, CancellationToken.None));

    private Task DeleteReply(string replyId) =>
        Remove(reviews => reviews.DeleteReplyAsync(new ReviewId(ReviewId!), Annotation.Id, replyId, CancellationToken.None));

    private IReviews? Reviews() => Services.GetService(typeof(IReviews)) as IReviews;

    private async Task Remove(Func<IReviews, Task<SaveAnnotationsOutcome>> delete)
    {
        if (ReviewId is null || Reviews() is not IReviews reviews) return;
        SaveAnnotationsOutcome outcome = await delete(reviews);
        if (outcome is SaveAnnotationsOutcome.Done)
        {
            await Changed.InvokeAsync();
        }
    }
}
