@if (Revisions.Count > 0)
{
    <Select Label="Revision" Value="@SelectedId" Options="Options" ValueChanged="RevisionChanged" data-revision />
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RevisionRow> Revisions { get; set; } = [];
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback<string> RevisionChanged { get; set; }

    private SelectOption[] Options => Revisions
        .Select(revision => new SelectOption(revision.RevisionId, RevisionLabel.Format(revision)))
        .ToArray();
}