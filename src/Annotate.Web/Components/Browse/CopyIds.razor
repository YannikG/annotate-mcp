@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@if (Visible)
{
    <div class="copy-ids @(dismissed ? "is-dismissed" : null)" data-copy-ids @onmouseleave="OpenAgain">
        <Button class="btn-icon" aria-label="Copy ids" tabindex="-1">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
        </Button>
        <div class="copy-menu" role="group" aria-label="Copy ids">
            <Button data-copy-plan tabindex="-1" OnClick="CopyPlan">Copy plan ID</Button>
            @if (!string.IsNullOrEmpty(ReviewId))
            {
                <Button data-copy-review tabindex="-1" OnClick="CopyReview">Copy review ID</Button>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string? PlanId { get; set; }

    [Parameter]
    public string? ReviewId { get; set; }

    private bool dismissed;

    private bool Visible =>
        !string.IsNullOrEmpty(PlanId) && Services.GetService<IClipboard>() is not null;

    private void OpenAgain() => dismissed = false;

    private Task CopyPlan() => Copy(IdCopy.Plan(PlanId!), IdCopy.PlanCopied);

    private Task CopyReview() => Copy(IdCopy.Review(ReviewId!), IdCopy.ReviewCopied);

    private async Task Copy(string text, string success)
    {
        dismissed = true;
        IClipboard? clipboard = Services.GetService<IClipboard>();
        IToast? toast = Services.GetService<IToast>();
        if (clipboard is null || toast is null)
        {
            return;
        }

        bool copied = await clipboard.CopyAsync(text);
        toast.Show(copied ? success : IdCopy.Failed);
    }
}
