<div class="frame">
    @if (Model.Selected is not null)
    {
        <RevisionView Model="Model.Selected">
            <Header>
                <ProjectBreadcrumb ProjectId="@Model.ProjectId" ProjectName="@Model.ProjectName" />
                <header class="page-title">
                    <div class="title-block">
                        <h1>@Model.Title</h1>
                        @if (SelectedRevision is not null)
                        {
                            <Badge Tone="@StatusTone.OfLabel(SelectedRevision.Status)" data-status>@SelectedRevision.Status</Badge>
                        }
                        @if (Model.ReadOnly)
                        {
                            <Badge data-read-only>Read-only</Badge>
                        }
                        @if (Model.Archived)
                        {
                            <Badge data-archived-document>Archived</Badge>
                        }
                    </div>
                    <div class="page-actions">
                        @if (Model.PendingReviewId is not null && !Model.ReadOnly)
                        {
                            <a class="btn btn-primary" data-continue-review href="/review/@Model.PendingReviewId">Continue review</a>
                        }
                        @if (Model.ReadOnly)
                        {
                            <Button data-edit-document OnClick="ClearReadOnly">Make editable</Button>
                        }
                        else
                        {
                            <Button data-read-only-document OnClick="MarkReadOnly">Read-only</Button>
                        }
                        @if (Model.Archived)
                        {
                            <Button data-restore OnClick="Restore">Restore</Button>
                        }
                        else
                        {
                            <Button data-archive OnClick="Archive">Archive</Button>
                        }
                        <Button Variant="ButtonVariant.Destructive" data-delete OnClick="Delete">Delete</Button>
                    </div>
                </header>
            </Header>
            <Controls>
                <RevisionPicker Revisions="Model.Revisions" SelectedId="@Model.SelectedId" RevisionChanged="RevisionChanged" />
            </Controls>
            <Actions>
                <Button Variant="ButtonVariant.Quiet" data-download-report OnClick="DownloadReport">Download report</Button>
            </Actions>
        </RevisionView>
    }
    @if (Model.ReportError is not null)
    {
        <p class="alert" role="alert" data-report-error>@Model.ReportError</p>
    }
    @if (Model.Error is not null)
    {
        <p class="alert" role="alert">@Model.Error</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public DocumentViewModel Model { get; set; } = default!;
    [Parameter] public EventCallback Archive { get; set; }
    [Parameter] public EventCallback Restore { get; set; }
    [Parameter] public EventCallback Delete { get; set; }
    [Parameter] public EventCallback MarkReadOnly { get; set; }
    [Parameter] public EventCallback ClearReadOnly { get; set; }
    [Parameter] public EventCallback DownloadReport { get; set; }
    [Parameter] public EventCallback<string> RevisionChanged { get; set; }

    private RevisionRow? SelectedRevision =>
        Model.Revisions.FirstOrDefault(revision => revision.RevisionId == Model.SelectedId);
}
