@page "/projects/{Id}"
@inject IPlans Plans
@inject IProjectPlanPages PlanPages

<PageTitle>@(model?.DisplayName ?? "Project") · Annotate</PageTitle>

@if (missing)
{
    <div class="frame">
        <h1>Not found</h1>
    </div>
}
else if (model is not null)
{
    <ProjectBrowse ProjectId="@Id" DisplayName="@model.DisplayName" FolderPath="@model.FolderPath"
        Archived="@model.Archived" Current="plans" Changed="Load">
        <ProjectView Model="model" TabSelected="SelectTab" PageSelected="SelectPage" />
    </ProjectBrowse>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private ProjectViewModel? model;

    private string? loadedId;

    private bool missing;

    private ProjectPlanTab tab = ProjectPlanTab.Pending;

    private int pageNumber = 1;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id)
        {
            return;
        }

        loadedId = Id;
        tab = ProjectPlanTab.Pending;
        pageNumber = 1;
        await Load();
    }

    private async Task Load()
    {
        ProjectSummary? project = await Plans.ProjectAsync(new ProjectId(Id), CancellationToken.None);
        if (project is null)
        {
            model = null;
            missing = true;
            return;
        }

        missing = false;
        ProjectPlanListing listing = await PlanPages.PageAsync(project.ProjectId, tab, pageNumber, CancellationToken.None);
        model = new ProjectViewModel(
            project.DisplayName,
            project.FolderPath,
            null,
            listing,
            project.Archived,
            tab,
            pageNumber);
    }

    private async Task SelectTab(ProjectPlanTab next)
    {
        tab = next;
        pageNumber = 1;
        await Load();
    }

    private async Task SelectPage(int next)
    {
        pageNumber = next < 1 ? 1 : next;
        await Load();
    }
}
