@page "/review/{Id}"
@inject IPlans Plans
@inject IReviews Reviews
@inject ISelectionReader Selection
@inject IAutoClosePreference Preferences
@inject IReportScript Report
@inject IServiceProvider Services
@inject NavigationManager Navigation

<PageTitle>@(string.IsNullOrEmpty(planTitle) ? "Review" : planTitle) · Annotate</PageTitle>

@if (notFound)
{
    <div class="frame">
        <h1>Review not found</h1>
    </div>
}
else if (failed)
{
    <div class="frame">
        <h1>Could not load this review</h1>
    </div>
}
else if (model is not null)
{
    <ReviewView Model="model" Key="OnKey" Approve="Approve" Download="Download" DismissReport="DismissReport" AutoCloseChanged="OnAutoClose" RequestChanges="RequestChanges" OpenPrompt="OpenPrompt" CloseDialog="CloseDialog" PreviousPrompt="PreviousPrompt" NextPrompt="NextPrompt" FinishPrompt="FinishPrompt" SaveNote="SaveNote" EditNote="EditNote" CancelNote="CancelNote" RetryDraft="RetryDraft" Select="OnSelect" Annotate="OnAnnotate" Changed="RefreshAnnotations" RemovePhrase="RemovePhrase" ToggleLock="ToggleLock" />
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private ReviewViewModel? model;

    private RevisionDetail? revision;

    private readonly List<Annotation> drafts = [];

    private readonly ReviewPrompts prompts = new();

    private readonly SubmitCountdown countdown = new();

    private bool pending;

    private bool autoClose;

    private ReviewStatus status;

    private bool notFound;

    private bool failed;

    private string? notice;

    private string? reportFailure;

    private DiffPanel? diff;

    private NotePrompt? notePrompt;

    private TextSelection? toolbar;

    private string? loadedId;

    private string planTitle = "";

    private string? projectId;

    private string? projectName;

    private bool allowApprove = true;

    private string? documentId;

    private readonly HashSet<string> lockedBlocks = new(StringComparer.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id)
        {
            return;
        }

        loadedId = Id;
        drafts.Clear();
        threads.Clear();
        prompts.Load([], []);
        countdown.Cancel();
        notFound = false;
        failed = false;
        notice = null;
        reportFailure = null;
        draftSaveStatus = null;
        autoClose = false;
        diff = null;
        notePrompt = null;
        toolbar = null;
        model = null;
        planTitle = "";
        projectId = null;
        projectName = null;
        allowApprove = true;
        documentId = null;
        lockedBlocks.Clear();
        ReviewDetail? review;
        try
        {
            review = await Reviews.FindAsync(new ReviewId(Id), CancellationToken.None);
        }
        catch (Exception)
        {
            failed = true;
            revision = null;
            pending = false;
            return;
        }

        if (review is null)
        {
            notFound = true;
            revision = null;
            pending = false;
            return;
        }

        try
        {
            revision = await Plans.RevisionAsync(
                new Annotate.Plans.Application.RevisionId(review.RevisionId.Value),
                CancellationToken.None);
        }
        catch (Exception)
        {
            failed = true;
            revision = null;
            pending = false;
            return;
        }

        foreach (Annotation annotation in review.Annotations)
        {
            (annotation.BlockKey is null ? drafts : threads).Add(annotation);
        }
        draftSaveStatus = review.Status == ReviewStatus.Pending && drafts.Count > 0 ? "Draft saved" : null;
        status = review.Status;
        pending = review.Status == ReviewStatus.Pending;
        prompts.Load(review.Prompts, review.Answers);
        if (revision is null)
        {
            DocumentReviewLoad loaded = await DocumentReviewLoad.Load(
                Services, Navigation, review.RevisionId.Value, CancellationToken.None);
            if (loaded.Redirected)
            {
                return;
            }

            if (loaded.Missing || loaded.Revision is null)
            {
                failed = true;
                return;
            }

            revision = loaded.Revision;
            allowApprove = false;
            documentId = revision.PlanId.Value;
            planTitle = loaded.Title;
            projectId = loaded.ProjectId;
            projectName = loaded.ProjectName;
            foreach (string key in loaded.LockedKeys)
            {
                lockedBlocks.Add(key);
            }
        }

        if (allowApprove)
        {
        autoClose = await Preferences.ReadAsync(CancellationToken.None);
        try
        {
            PlanDetail? plan = await Plans.PlanAsync(revision.PlanId, CancellationToken.None);
            planTitle = plan?.Title ?? "";
            if (plan is not null)
            {
                ProjectSummary? project = await Plans.ProjectAsync(plan.ProjectId, CancellationToken.None);
                projectId = project?.ProjectId.Value;
                projectName = project?.DisplayName;
            }
        }
        catch (Exception)
        {
            planTitle = "";
            projectId = null;
            projectName = null;
        }
        }

        Publish();
    }

    private async Task OnKey(ReviewKey key)
    {
        if (key.Key == "Escape")
        {
            notePrompt = null;
            toolbar = null;
            countdown.Cancel();
            Publish();
            return;
        }

        if (!pending)
        {
            return;
        }

        if (key.Key == "u")
        {
            if (drafts.Count > 0)
            {
                drafts.RemoveAt(drafts.Count - 1);
                await PersistDrafts();
            }

            return;
        }

        if (key.Key == "d" && diff is not null)
        {
            diff = null;
            notice = null;
            Publish();
            return;
        }

        AnnotationKind? kind = key.Key switch
        {
            "d" => AnnotationKind.Deletion,
            "r" => AnnotationKind.Replacement,
            "s" => AnnotationKind.Insertion,
            "c" => AnnotationKind.Comment,
            _ => null,
        };
        if (kind is null)
        {
            return;
        }

        TextSelection? selection = await Selection.ReadAsync();
        if (!Usable(selection))
        {
            selection = toolbar;
        }

        if (!Usable(selection))
        {
            if (kind == AnnotationKind.Deletion)
            {
                await OpenDiff();
            }

            return;
        }

        TextSelection chosen = selection!;
        if (Locked(chosen.BlockOrdinal))
        {
            RefuseLocked();
            return;
        }

        toolbar = null;
        if (kind is AnnotationKind.Replacement or AnnotationKind.Insertion or AnnotationKind.Comment)
        {
            notePrompt = new NotePrompt(kind.Value, chosen);
            Publish();
            return;
        }

        drafts.Add(new Annotation(
            Guid.NewGuid().ToString(),
            AnnotationKind.Deletion,
            chosen.Text,
            null,
            null,
            chosen.BlockOrdinal,
            chosen.Start,
            chosen.End,
            DateTimeOffset.UtcNow.ToString("u")));
        countdown.Start();
        await PersistDrafts();
    }

    private async Task OpenDiff()
    {
        if (revision is null)
        {
            return;
        }

        ReviewDiffAttempt attempt = await ReviewDiff.Open(
            Plans,
            documentId is null ? null : Services.GetService<IDocuments>(),
            revision,
            CancellationToken.None);
        if (!attempt.Changed)
        {
            return;
        }

        diff = attempt.Panel;
        notice = attempt.Notice;
        Publish();
    }

    private async Task Approve()
    {
        if (!pending || prompts.Any || drafts.Count > 0 || threads.Count > 0)
        {
            return;
        }

        string reviewId = Id;
        await draftSave;
        if (reviewId != Id || !pending) return;
        DecideOutcome outcome = await Reviews.ApproveAsync(new ReviewId(reviewId), CancellationToken.None);
        await Finish(outcome, ReviewStatus.Approved);
    }

    private async Task Download()
    {
        if (!pending || prompts.Any || drafts.Count > 0 || threads.Count > 0 || revision is null)
        {
            return;
        }

        ReportDownload download = await Report.DownloadAsync(
            PlanReport.Html(revision.Summary, revision.StoryUrl, revision.AcceptanceCriteria, revision.Markdown),
            "plan.html");
        if (!download.Saved)
        {
            reportFailure = download.Error;
            Publish();
            return;
        }

        reportFailure = null;
        await Approve();
    }

    private void DismissReport()
    {
        reportFailure = null;
        Publish();
    }

    private async Task OnAutoClose(bool value)
    {
        if (await Preferences.WriteAsync(value, CancellationToken.None))
        {
            autoClose = value;
        }

        Publish();
    }

    private async Task RequestChanges()
    {
        if (!pending)
        {
            return;
        }

        string reviewId = Id;
        await draftSave;
        if (reviewId != Id || !pending) return;
        if (await DocumentReadOnly())
        {
            notice = "Document is read-only.";
            Publish();
            return;
        }

        DecideOutcome outcome = await Reviews.RequestChangesAsync(
            new ReviewId(reviewId),
            drafts.ToArray(),
            CancellationToken.None);
        await Finish(outcome, ReviewStatus.ChangesRequested);
    }

    private async Task Finish(DecideOutcome outcome, ReviewStatus decidedStatus)
    {
        countdown.Cancel();
        if (outcome is DecideOutcome.Done)
        {
            status = decidedStatus;
            pending = false;
            drafts.Clear();
            threads.Clear();
            notePrompt = null;
            toolbar = null;
            draftSaveStatus = null;
            reportFailure = null;
        }

        Publish();
        if (outcome is DecideOutcome.Done && autoClose)
        {
            await Report.CloseAsync();
        }
    }

    private void Publish()
    {
        if (revision is null)
        {
            return;
        }

        Annotation? activeNote = notePrompt is null
            ? null
            : new Annotation(
                notePrompt.Id,
                notePrompt.Kind,
                notePrompt.Selection.Text,
                null,
                null,
                notePrompt.Selection.BlockOrdinal,
                notePrompt.Selection.Start,
                notePrompt.Selection.End,
                notePrompt.CreatedAt);
        model = new ReviewViewModel(
            StatusTone.Label(status),
            pending,
            pending && allowApprove && !prompts.Any && drafts.Count == 0 && threads.Count == 0,
            revision.Summary,
            revision.StoryUrl,
            revision.AcceptanceCriteria,
            revision.Markdown,
            drafts.Concat(threads).ToArray(),
            countdown.Count,
            countdown.Running,
            prompts.Rows(),
            prompts.Dialog(),
            notice,
            diff,
            autoClose,
            reportFailure,
            planTitle,
            notePrompt is null
                ? null
                : new NotePromptModel(NoteTitle(notePrompt.Kind), notePrompt.Selection.Text, notePrompt.Selection.Box),
            notePrompt is null ? toolbar?.Box : null,
            draftSaveStatus,
            activeNote,
            revision.Attribution,
            projectId,
            projectName,
            allowApprove ? revision.PlanId.Value : null,
            Id,
            revision.Blocks.Select(block => block.Key).ToArray(),
            BlockNames.Of(revision),
            allowApprove,
            allowApprove ? null : lockedBlocks,
            allowApprove ? "/plans/" + revision.PlanId.Value : documentId is null ? null : "/documents/" + documentId);
    }
}
